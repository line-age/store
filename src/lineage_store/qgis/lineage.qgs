    <properties name="Macros">
      <properties name="pythonCode" type="QString">from qgis.core import Qgis, QgsInterval, QgsProject
from qgis.utils import iface


def openProject():
    # QGIS doesn't save the Temporal Controller's mode in a project, so set it on open.
    nav = iface.mapCanvas().temporalController()
    nav.setTemporalExtents(QgsProject.instance().timeSettings().temporalRange())
    nav.setFrameDuration(QgsInterval(1, Qgis.TemporalUnit.Years))
    nav.setNavigationMode(Qgis.TemporalNavigationMode.Animated)
    nav.setCurrentFrameNumber(0)


def saveProject():
    pass


def closeProject():
    pass
</properties>
